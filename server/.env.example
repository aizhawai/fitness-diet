# ============================================================
# LLM 配置。三项必填齐全才启用 AI，任意一项留空则自动降级为纯算法食谱生成。
#
# 支持两套协议：
#   openai    —— {地址}/chat/completions + Authorization: Bearer
#   anthropic —— {地址}/v1/messages + x-api-key + anthropic-version
# 协议不用手动配：地址里带 /anthropic 就自动走 anthropic，否则走 openai。
# 需要强制指定时设 LLM_PROTOCOL=openai|anthropic。
# ============================================================


# ---------- 方案 A：Anthropic 协议（MiniMax，推荐）----------

# 注意国内站的 key 只能在 .cn / .minimaxi.com 上用，国际站 api.minimax.io 会 401
LLM_BASE_URL=https://api.minimax.cn/anthropic
LLM_API_KEY=
LLM_MODEL=MiniMax-M3.1-Flash-Preview

# 思考强度（可选，仅 anthropic 协议生效）。代码不校验，原样透传给模型。
# MiniMax 接受 low / medium / high / xhigh / max —— 填错会直接 400
# 换别家模型就填它自己认的值，不确定就留空
LLM_EFFORT=xhigh

# 超时毫秒（可选，默认 30000）。开了思考强度响应会变慢，被 30s 卡住时调大
# LLM_TIMEOUT_MS=60000


# ---------- 方案 B：OpenAI 兼容协议（DeepSeek / Kimi / 通义 / 智谱）----------
# 用这套时把下面四行启用、把上面四行注释掉。
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat
#
# 注意：LLM_EFFORT 只在 anthropic 协议下下发，OpenAI 这条路上不发这个字段。


# ============================================================
# 以下一般不用改
# ============================================================

# 后端端口
PORT=3000

# 数据目录，留空则用 server/data
# 备份数据库 = 复制 server/data/app.db 这个文件
# DATA_DIR=D:/somewhere/fitness-data
