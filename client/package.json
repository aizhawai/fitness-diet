{
  "name": "fitness-diet-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean:vite": "node -e \"const fs=require('fs');const p='node_modules/.vite';if(fs.existsSync(p)){fs.rmSync(p,{recursive:true,force:true});console.log('[clean:vite] removed '+p)}else{console.log('[clean:vite] nothing to remove')}\"",
    "predev:h5": "npm run clean:vite",
    "dev:h5": "uni",
    "build:h5": "uni build",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-components": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5030120260930001",
    "pinia": "^2.3.1",
    "vue": "3.4.21"
  },
  "overrides": {
    "@vue/shared": "3.4.21",
    "@vue/runtime-core": "3.4.21",
    "@vue/runtime-dom": "3.4.21",
    "@vue/reactivity": "3.4.21",
    "@vue/server-renderer": "3.4.21",
    "@vue/compiler-sfc": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-stacktracey": "3.0.0-alpha-5030120260930001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5030120260930001",
    "@types/node": "^24.10.1",
    "sass": "^1.93.2",
    "typescript": "^5.9.3",
    "vite": "5.2.8",
    "vue-tsc": "^2.2.12"
  }
}
